# Copy to .env.local. Never commit secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails permitted to publish (also verified against Supabase Auth)
ADMIN_EMAILS=
# Optional: domain from your own licensed map-tile provider. For public launch use a paid/permissioned service.
NEXT_PUBLIC_MAP_TILE_URL=https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors · © CARTO

# CARTO basemap key (public browser-side key)
NEXT_PUBLIC_CARTO_API_KEY=
